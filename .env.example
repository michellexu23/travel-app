# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API Keys / Data API.
# .env.local is git-ignored. These two values are PUBLIC by design (they ship
# inside the app); Row Level Security is what protects the data.
# NEVER put the database password or a secret (sb_secret_...) key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
